# Live provider
LIVE_PROVIDER=OPENF1_PAID
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Toggle the local OpenF1 race replay server.
# When true, backend REST bootstrap + live stream use the local mock server
# instead of connecting to OpenF1 directly.
USE_MOCK_OPENF1=false

# Mock replay controls
MOCK_OPENF1_PORT=8091
MOCK_OPENF1_SPEED=20
MOCK_OPENF1_TICK_MS=250
MOCK_OPENF1_LOOP=true
MOCK_OPENF1_LOOP_DELAY_MS=5000

# Optional: force a specific completed OpenF1 session_key.
# Leave blank to auto-select the latest completed Race session.
MOCK_OPENF1_SESSION_KEY=
